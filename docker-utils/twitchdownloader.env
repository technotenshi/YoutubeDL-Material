# Pinned TwitchDownloaderCLI release. One definition shared by the image build
# (docker-utils/fetch-twitchdownloader.sh) and the live checks workflow (#41).
# Plain NAME=value lines, safe to source from sh or bash.
#
# The sha256 values are the digests GitHub publishes for each release asset.
# Upstream publishes no separate signed checksums, so they are trusted on first
# use. The downloaded zip is checked against them and the build fails on a
# mismatch.
#
# To update: choose a release tag, then copy the digest of each CLI asset.
#   gh api repos/lay295/TwitchDownloader/releases/tags/<tag> \
#     --jq '.assets[] | select(.name | startswith("TwitchDownloaderCLI-")) | "\(.name) \(.digest)"'
# Dependabot does not track this file, so updates are manual.
TWITCHDOWNLOADER_VERSION=1.56.5
TWITCHDOWNLOADER_SHA256_LINUX_X64=f2bcee00d0e6da759d97c23767345634cb9cdb10cdff96cfa96f97983d51bf55
TWITCHDOWNLOADER_SHA256_LINUX_ARM64=2fde836f07c3ebfcf61cace23742a2c43543fc30fda96071eb96ab8e10c24f7f
TWITCHDOWNLOADER_SHA256_LINUX_ARM=ca66f85248f45f6f2870d6ca27bbd841e911d3f80a88fc3e76b33575169121cc
