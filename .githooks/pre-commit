#!/usr/bin/env bash
# Scan staged changes for secrets before each commit.
# Enable with: git config core.hooksPath .githooks
set -Eeuo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found; install it or run: git config --unset core.hooksPath" >&2
  exit 1
fi

root="$(git rev-parse --show-toplevel)"
exec gitleaks git --pre-commit --staged --redact --no-banner --config "${root}/.gitleaks.toml"
